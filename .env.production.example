# ==============================================================================
#  TOP CRM — cấu hình PRODUCTION (máy chủ công khai). Sao chép thành .env trên máy chủ
#  rồi điền giá trị thật. KHÔNG đưa tệp .env thật lên Git hay gửi cho ai.
#  Kiểm tra sau khi điền: php artisan crm:production-check
# ==============================================================================
APP_NAME="TOP CRM"
APP_ENV=production
APP_DEBUG=false
# APP_KEY: chép NGUYÊN từ máy hiện tại (C:\phuc-crm\.env). Đổi khóa = mất toàn bộ thông tin nhạy cảm đã mã hóa
# (CCCD, ngày sinh nhân viên, khóa 2FA...). Chỉ tạo mới (php artisan key:generate) nếu cài đặt từ đầu.
APP_KEY=
APP_URL=https://crm.ten-mien-cua-ban.vn

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Tạo user MySQL riêng (KHÔNG dùng root), chỉ cấp quyền trên database CRM — xem docs/GO_LIVE.md
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orangecrm_db
DB_USERNAME=topcrm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Đứng sau Nginx cùng máy: để trống. Sau Cloudflare / load balancer: * (hoặc danh sách IP proxy)
TRUSTED_PROXIES=

# Máy chủ gửi thư — cần cho "quên mật khẩu" và thông báo email
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@ten-mien-cua-ban.vn"
MAIL_FROM_NAME="${APP_NAME}"

# Không tạo dữ liệu demo trên máy chủ thật
CRM_DEMO_DATA=false

VITE_APP_NAME="${APP_NAME}"
